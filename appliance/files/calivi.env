# Calivi on calivi-vm. Per-machine secrets live in secret.env (created at first boot).
DB_PATH=/var/lib/calivi/calivi.db
SYSTEM_PROMPTS_PATH=/var/lib/calivi/config/system_prompts.yml
SEARCH_CONFIG_PATH=/var/lib/calivi/config/search.yml
TOOLS_CONFIG_PATH=/var/lib/calivi/config/tools.yml
VISION_OVERRIDES_PATH=/var/lib/calivi/config/vision_models.yml
# Plain HTTP on :80 — with the Secure flag the browser would never send the session cookie.
# Put a TLS proxy in front and set this to true if the machine leaves the LAN.
COOKIE_SECURE=false
CORS_ORIGINS=
# The model operates this machine (tools/host.py).
CALIVI_HOST_TOOLS=1
# Present while a reply runs; an upgrade waits for it before restarting (#95).
CALIVI_BUSY_FILE=/run/calivi/busy
